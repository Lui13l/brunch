
PORT=3000

# Cadena de conexión de MongoDB Atlas (pídela al equipo).
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/brunch

# Clave para firmar los tokens de sesión. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta
JWT_EXPIRES_IN=7d

# ID de cliente OAuth 2.0 para Google Identity Services.
GOOGLE_CLIENT_ID=
# Orígenes permitidos para el frontend, separados por coma. Vacío = todos.
# 5173 = web de clientes, 5174 = app de comandas.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Orígenes permitidos para el WebSocket (/ws). Vacío = los de CORS_ORIGIN.
# Para usar comandas desde el celular en la misma red, agrega la IP de tu PC:
# WS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://192.168.1.50:5174
WS_ORIGINS=

# Zona horaria del restaurante (reportes por día y horas que ve el personal).
ZONA_HORARIA=America/Bogota

# Usuario administrador que crea "npm run seed".
ADMIN_CORREO=admin@brunch.com
ADMIN_PASSWORD=admin123

# Cuentas del personal del salón que crea "npm run seed" (opcionales).
MESERO_CORREO=
MESERO_PASSWORD=
COCINA_CORREO=
COCINA_PASSWORD=

# Límite de intentos fallidos de login/registro por IP cada 15 minutos.
RATE_LIMIT_AUTH_MAX=10
# Límite de mensajes al chatbot por usuario cada minuto.
RATE_LIMIT_CHAT_MAX=20

# Solo en producción detrás de un proxy (Render, Railway, Nginx...): número de saltos.
# TRUST_PROXY=1
