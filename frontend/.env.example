# Copia este archivo como .env si el backend no está en http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# ID de cliente OAuth 2.0 para Google Identity Services (el mismo del backend).
VITE_GOOGLE_CLIENT_ID=

# Dirección de la app del personal (comandas). La usa el botón "Abrir comandas"
# del panel de administración. Por defecto http://localhost:5174.
VITE_PERSONAL_URL=http://localhost:5174
